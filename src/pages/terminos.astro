---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout
  title="Términos y condiciones"
  description="Términos y condiciones de uso de la plataforma Reto."
  lang={lang}
>
  <section class="legal-page">
    <div class="legal-page__inner">
      <h1>{t('legalPlaceholder.termsTitle')}</h1>
      <p>{t('legalPlaceholder.body')}</p>
      <a href="/">&larr; {t('legalPlaceholder.backLink')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    min-height: 50vh;
    display: flex;
    align-items: center;
    padding-block: var(--space-24);
    padding-inline: var(--container-padding);
  }

  .legal-page__inner {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .legal-page__inner p {
    margin-top: var(--space-6);
    color: rgba(32, 30, 30, 0.76);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .legal-page__inner a {
    display: inline-block;
    margin-top: var(--space-8);
    color: var(--color-azul-acero);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-small);
    text-decoration: none;
  }

  .legal-page__inner a:hover {
    text-decoration: underline;
  }
</style>
