---
import esJson from '../../i18n/es.json';
import enJson from '../../i18n/en.json';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = lang === 'en' ? enJson : esJson;
const { title, items: values } = dict.whatIsReto.values;
---

<section class="values-section" aria-labelledby="values-title">
  <div class="values-section__inner">
    <h2 id="values-title">{title}</h2>

    <div class="values-grid">
      {
        values.map((value) => (
          <article class="value-card">
            <h3 class="value-card__title">{value.title}</h3>
            <p class="value-card__description">{value.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .values-section {
    background: white;
    padding-block: var(--space-24);
    padding-inline: var(--container-padding);
  }

  .values-section__inner {
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .values-section h2 {
    text-align: center;
    color: var(--color-pelicula);
    margin-bottom: var(--space-12);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .value-card {
    border: 1px solid rgba(32, 30, 30, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-aliceblue);
    padding: var(--space-8);
  }

  .value-card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h4);
    color: var(--color-pelicula);
    line-height: 1.2;
  }

  .value-card__description {
    margin-top: var(--space-3);
    color: rgba(32, 30, 30, 0.76);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  @media (min-width: 48em) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64em) {
    .values-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
